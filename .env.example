APP_ENV=development
APP_NAME=国家油气管网智能生产运营辅助系统
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# MCP Streamable HTTP 的 Host/Origin 白名单；部署到其他域名时显式添加
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]

# 本项目专用基础设施的开发账号；完整 Docker Compose 部署也使用这些值
POSTGRES_DB=pipechina
POSTGRES_USER=peter
POSTGRES_PASSWORD=123456
RABBITMQ_DEFAULT_USER=peter
RABBITMQ_DEFAULT_PASS=123456

# PyCharm/宿主机进程通过映射端口访问项目专用容器
DATABASE_URL=postgresql+asyncpg://peter:123456@127.0.0.1:5432/pipechina
JWT_ISSUER=http://mock-idp:9001
JWT_AUDIENCE=pipechina-backend
JWT_ALGORITHM=RS256
JWT_JWKS_URL=http://127.0.0.1:9001/.well-known/jwks.json
AUTO_CREATE_SCHEMA=false
AUTO_SEED=false
RUN_TASKS_INLINE=false

TEXT_PROVIDER=qwen
ASR_PROVIDER=local_http
VISION_PROVIDER=local_http
STORAGE_PROVIDER=local_filesystem

CELERY_BROKER_URL=amqp://peter:123456@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/0

LOCAL_STORAGE_ROOT=./data/objects
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:8000
LOCAL_STORAGE_SIGNING_SECRET=development-local-storage-secret-change-me

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus

ASR_BASE_URL=http://127.0.0.1:8101
ASR_MODEL=large-v3
ASR_API_KEY=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

VISION_BASE_URL=http://127.0.0.1:8102
VISION_MODEL=openbmb/MiniCPM-V-4.6
VISION_API_KEY=

# OpenAI 时使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_ASR_MODEL=gpt-4o-transcribe

# 自训模型实现兼容接口并修改Provider配置
CUSTOM_TEXT_BASE_URL=http://127.0.0.1:8201/v1
CUSTOM_TEXT_MODEL=custom-text-model
CUSTOM_TEXT_API_KEY=

# AWS S3可选配置
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pipechina-private
S3_REGION=us-east-1
S3_USE_SSL=true
S3_ADDRESSING_STYLE=auto

PROVIDER_TIMEOUT_SECONDS=60
MEDIA_PROVIDER_TIMEOUT_SECONDS=900
PROVIDER_MAX_RETRIES=2
PROVIDER_TRUST_ENV=false

# 项目专用检索基础设施与知识运行时
KNOWLEDGE_BACKEND=http
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.8
ES_URL=http://127.0.0.1:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_API_KEY=
QDRANT_IMAGE=qdrant/qdrant:v1.15.5
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
NEO4J_IMAGE=neo4j:5.26.12
NEO4J_URL=http://127.0.0.1:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
KNOWLEDGE_RUNTIME_URL=http://127.0.0.1:8103
KNOWLEDGE_SERVICE_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KNOWLEDGE_MODEL_DEVICE=cpu
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_INTERVAL_SECONDS=20

# 上传限制；逗号分隔的音频MIME类型由Pydantic Settings解析为元组
MAX_AUDIO_BYTES=524288000
MEETING_RECORDING_RETENTION_DAYS=
ALLOWED_AUDIO_TYPES=["audio/mpeg","audio/mp4","audio/wav","audio/x-wav","audio/webm","audio/ogg","audio/flac","audio/x-m4a"]

REQUEST_RATE_LIMIT_PER_MINUTE=600
OPS_METRICS_TOKEN=

# Optional read-only weather / map / enterprise GIS tools. No extra containers.
# QWeather console assigns an HTTPS API host. Configure one authentication method.
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_JWT=
# Amap Web Service API key; converts confirmed WGS84 coordinates before map queries.
AMAP_API_KEY=
# JSON mapping local organization UUID -> authorized ArcGIS FeatureServer/MapServer layer URL.
ENTERPRISE_GIS_LAYERS={}
ENTERPRISE_GIS_TOKEN=
ENTERPRISE_GIS_FIELDS=OBJECTID,name,type
SITE_CONTEXT_RADIUS_METERS=3000
SITE_CONTEXT_TIMEOUT_SECONDS=10
SITE_CONTEXT_TTL_SECONDS=300
